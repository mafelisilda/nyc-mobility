{
  "datasets": [
    {
      "name": "data_quality",
      "displayName": "Data Quality Checks",
      "config": {
        "version": "1.1",
        "source": "nyc_mobility.gold.dq_check_results",
        "dimensions": [
          {
            "name": "check_id",
            "expr": "check_id"
          },
          {
            "name": "check_type",
            "expr": "check_type"
          },
          {
            "name": "table_name",
            "expr": "table_name"
          },
          {
            "name": "check_name",
            "expr": "check_name"
          },
          {
            "name": "check_description",
            "expr": "check_description"
          },
          {
            "name": "status",
            "expr": "status"
          },
          {
            "name": "severity",
            "expr": "severity"
          },
          {
            "name": "checked_at",
            "expr": "checked_at"
          }
        ],
        "measures": [
          {
            "name": "total_checks",
            "expr": "COUNT(1)"
          },
          {
            "name": "passing_checks",
            "expr": "COUNT(1) FILTER (WHERE status = 'PASS')"
          },
          {
            "name": "warning_checks",
            "expr": "COUNT(1) FILTER (WHERE status = 'WARN')"
          },
          {
            "name": "failing_checks",
            "expr": "COUNT(1) FILTER (WHERE status = 'FAIL')"
          },
          {
            "name": "avg_pass_rate",
            "expr": "AVG(pass_rate)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "total_failed_count",
            "expr": "SUM(failed_count)"
          }
        ]
      }
    },
    {
      "name": "job_execution",
      "displayName": "Job Execution",
      "config": {
        "version": "1.1",
        "source": "nyc_mobility.gold.job_run_history",
        "dimensions": [
          {
            "name": "run_id",
            "expr": "run_id"
          },
          {
            "name": "run_name",
            "expr": "run_name"
          },
          {
            "name": "state",
            "expr": "state",
            "displayName": "Life Cycle State"
          },
          {
            "name": "result_state",
            "expr": "result_state",
            "displayName": "Result State"
          },
          {
            "name": "start_time",
            "expr": "start_time"
          },
          {
            "name": "end_time",
            "expr": "end_time"
          },
          {
            "name": "trigger",
            "expr": "trigger"
          },
          {
            "name": "creator",
            "expr": "creator"
          },
          {
            "name": "run_page_url",
            "expr": "run_page_url"
          },
          {
            "name": "number_in_job",
            "expr": "number_in_job"
          }
        ],
        "measures": [
          {
            "name": "run_count",
            "expr": "COUNT(1)"
          },
          {
            "name": "successful_runs",
            "expr": "COUNT(1) FILTER (WHERE result_state = 'SUCCESS')"
          },
          {
            "name": "failed_runs",
            "expr": "COUNT(1) FILTER (WHERE result_state = 'FAILED')"
          },
          {
            "name": "failure_rate",
            "expr": "COUNT(1) FILTER (WHERE result_state = 'FAILED') * 1.0 / COUNT(1)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          },
          {
            "name": "avg_duration_ms",
            "expr": "AVG(duration_ms)"
          },
          {
            "name": "latest_run_time",
            "expr": "MAX(start_time)"
          }
        ]
      }
    },
    {
      "name": "task_failures",
      "displayName": "Task Failures",
      "config": {
        "source": "nyc_mobility.gold.task_run_history",
        "measures": [
          {
            "name": "failure_count",
            "expr": "COUNT(1)"
          }
        ],
        "filter": "result_state = 'FAILED'",
        "version": "1.1",
        "dimensions": [
          {
            "name": "run_id",
            "expr": "run_id"
          },
          {
            "name": "task_key",
            "expr": "task_key"
          },
          {
            "name": "result_state",
            "expr": "result_state"
          },
          {
            "name": "start_time",
            "expr": "start_time"
          },
          {
            "name": "end_time",
            "expr": "end_time"
          }
        ]
      }
    },
    {
      "name": "task_execution",
      "displayName": "Task Execution",
      "config": {
        "version": "1.1",
        "source": "nyc_mobility.gold.task_run_history",
        "dimensions": [
          {
            "name": "run_id",
            "expr": "run_id"
          },
          {
            "name": "task_key",
            "expr": "task_key"
          },
          {
            "name": "state",
            "expr": "state",
            "displayName": "Life Cycle State"
          },
          {
            "name": "result_state",
            "expr": "result_state",
            "displayName": "Result State"
          },
          {
            "name": "start_time",
            "expr": "start_time"
          },
          {
            "name": "end_time",
            "expr": "end_time"
          }
        ],
        "measures": [
          {
            "name": "task_count",
            "expr": "COUNT(1)"
          },
          {
            "name": "failed_task_count",
            "expr": "COUNT(1) FILTER (WHERE result_state = 'FAILED')"
          },
          {
            "name": "avg_duration_ms",
            "expr": "AVG(duration_ms)"
          },
          {
            "name": "total_duration_ms",
            "expr": "SUM(duration_ms)"
          },
          {
            "name": "task_failure_rate",
            "expr": "COUNT(1) FILTER (WHERE result_state = 'FAILED') * 1.0 / COUNT(1)",
            "format": {
              "type": "percentage",
              "decimalPlaces": {
                "type": "exact",
                "places": 1.0
              }
            }
          }
        ]
      }
    },
    {
      "name": "freshness",
      "displayName": "Data Freshness",
      "config": {
        "version": "1.1",
        "source": "WITH fact_latest AS (\n  SELECT MAX(d.full_date) AS latest_date\n  FROM nyc_mobility.gold.fact_trip ft\n  JOIN nyc_mobility.gold.dim_date d ON ft.pickup_date_key = d.date_key\n) SELECT 'dim_date' AS table_name, 'full_date' AS freshness_column,\n       CAST(MAX(full_date) AS STRING) AS latest_data,\n       DATEDIFF(CURRENT_DATE(), MAX(full_date)) AS days_stale,\n       CASE WHEN DATEDIFF(CURRENT_DATE(), MAX(full_date)) <= 1 THEN 'FRESH' ELSE 'STALE' END AS status,\n       CAST(COUNT(*) AS INT) AS row_count\nFROM nyc_mobility.gold.dim_date GROUP BY 1, 2 UNION ALL SELECT 'fact_trip' AS table_name, 'pickup_date' AS freshness_column,\n       CAST((SELECT latest_date FROM fact_latest) AS STRING) AS latest_data,\n       DATEDIFF(CURRENT_DATE(), (SELECT latest_date FROM fact_latest)) AS days_stale,\n       CASE WHEN DATEDIFF(CURRENT_DATE(), (SELECT latest_date FROM fact_latest)) <= 1 THEN 'FRESH' ELSE 'STALE' END AS status,\n       CAST(COUNT(*) AS INT) AS row_count\nFROM nyc_mobility.gold.fact_trip GROUP BY 1, 2 UNION ALL SELECT 'dim_hour' AS table_name, 'N/A' AS freshness_column,\n       'N/A' AS latest_data, NULL AS days_stale, 'UNKNOWN' AS status,\n       CAST(COUNT(*) AS INT) AS row_count\nFROM nyc_mobility.gold.dim_hour GROUP BY 1, 2, 3, 4, 5 UNION ALL SELECT 'dim_weather' AS table_name, 'N/A' AS freshness_column,\n       'N/A' AS latest_data, NULL AS days_stale, 'UNKNOWN' AS status,\n       CAST(COUNT(*) AS INT) AS row_count\nFROM nyc_mobility.gold.dim_weather GROUP BY 1, 2, 3, 4, 5 UNION ALL SELECT 'dim_zone' AS table_name, 'N/A' AS freshness_column,\n       'N/A' AS latest_data, NULL AS days_stale, 'UNKNOWN' AS status,\n       CAST(COUNT(*) AS INT) AS row_count\nFROM nyc_mobility.gold.dim_zone GROUP BY 1, 2, 3, 4, 5\n",
        "dimensions": [
          {
            "name": "table_name",
            "expr": "table_name",
            "displayName": "Table Name"
          },
          {
            "name": "freshness_column",
            "expr": "freshness_column",
            "displayName": "Freshness Column"
          },
          {
            "name": "latest_data",
            "expr": "latest_data",
            "displayName": "Latest Data"
          },
          {
            "name": "days_stale",
            "expr": "days_stale",
            "displayName": "Days Stale"
          },
          {
            "name": "status",
            "expr": "status",
            "displayName": "Status"
          },
          {
            "name": "row_count",
            "expr": "row_count",
            "displayName": "Row Count"
          }
        ]
      }
    }
  ],
